  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
